    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
