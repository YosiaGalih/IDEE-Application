# KodeKantor configuration (docs/CONFIGURATION.md). `make setup` (scripts/gen-secrets.sh) copies this file
# to .env (mode 600) and fills every value marked >>> GENERATED <<< with random data.
# Values marked >>> SET <<< must be edited before `make up`. Never commit .env.
#
# Derived by infra/compose.yml, do not set here: DATABASE_URL, REDIS_URL, WORKSPACE_ROOT,
# SANDBOX_MANAGER_URL, DOCKER_HOST, SANDBOX_PROFILES_PATH.

# --- Application -------------------------------------------------------------------------------------
APP_ENV=production
APP_DOMAIN=>>> SET <<<
APP_URL=>>> SET <<<
CADDY_EMAIL=>>> SET <<<
CADDY_HSTS_MAX_AGE=31536000
LOG_LEVEL=INFO
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=7

# --- Secrets (generated) -----------------------------------------------------------------------------
SECRET_KEY=>>> GENERATED <<<
SANDBOX_MANAGER_TOKEN=>>> GENERATED <<<
POSTGRES_PASSWORD=>>> GENERATED <<<
# Runtime DB role kodekantor_app (api, worker, scheduler); POSTGRES_PASSWORD stays with postgres and migrate.
DB_APP_PASSWORD=>>> GENERATED <<<
REDIS_PASSWORD=>>> GENERATED <<<

# --- Claude (worker only; ADR-004) -------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_REQUIRE_READINESS=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL_DEFAULT=>>> SET <<<
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_COMPLEX=
CLAUDE_MAX_OUTPUT_TOKENS=8192
CLAUDE_REQUEST_TIMEOUT_SECONDS=120
CLAUDE_MAX_TOOL_ITERATIONS=40

# --- Task budget (ADR-004, ADR-010) ------------------------------------------------------------------
TASK_MAX_COST_USD=2.0
TASK_MAX_TOKENS=400000
TASK_MAX_DEBUG_ATTEMPTS=5
TASK_AUTO_REMEDIATION_MAX=1
TASK_MAX_DURATION_MINUTES=60
TASK_MAX_ITERATIONS=3
MAX_ACTIVE_TASKS=2
CELERY_WORKER_CONCURRENCY=2

# --- Workspace (ADR-005) -----------------------------------------------------------------------------
# Bind-mounted at the same path inside api, worker and sandbox-manager; owner 10001:10001, mode 0750.
WORKSPACE_HOST_PATH=/srv/kodekantor/workspaces
PROJECT_QUOTA_MB=2048
UPLOAD_MAX_MB=200
GIT_IMPORT_ALLOWED_HOSTS=github.com,gitlab.com,codeberg.org

# --- Sandbox (ADR-007, ADR-009, ADR-033) -------------------------------------------------------------
SANDBOX_IMAGE_PYTHON=kodekantor/sandbox-python:1
SANDBOX_IMAGE_NODE=kodekantor/sandbox-node:1
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_WORKSPACE_GROWTH_MB=512
SANDBOX_MAX_CONCURRENT_RUNS=4
# Dependency installs through egress-proxy (ADR-007): only after the security gate (RUNBOOK §11), and then
# together with COMPOSE_PROFILES=egress below; healthcheck.sh fails if allowlist runs without the proxy.
SANDBOX_EGRESS=off
SANDBOX_RUNTIME=

# --- Compose and networks (spec WP-1.5b) --------------------------------------------------------------
# Empty: no egress-proxy. "egress" starts it with the kk-egress network (with SANDBOX_EGRESS=allowlist).
COMPOSE_PROFILES=
# api believes X-Forwarded-For only from Caddy's fixed address on edge. Change the three together if
# 10.231.231.0/28 collides with another Docker network on this host; the Caddy address stays outside the range.
KK_EDGE_SUBNET=10.231.231.0/28
KK_EDGE_IP_RANGE=10.231.231.8/29
KK_EDGE_CADDY_IP=10.231.231.2

# --- Build and observability -------------------------------------------------------------------------
KK_IMAGE_TAG=dev
# Optional CA bundle of a TLS-intercepting proxy, used only while building images (never stored).
KK_BUILD_CA_FILE=
OTEL_EXPORTER_OTLP_ENDPOINT=
