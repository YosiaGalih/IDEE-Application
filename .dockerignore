# Build context of every kodekantor/* image: the repository root (infra/compose.yml).
# Send the daemon only what the Dockerfiles copy, never .git, .env or local virtualenvs. A new COPY source
# must be added here; the build fails loudly until it is.
*
!infra/build/uv-requirements.txt
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/alembic/
!backend/app/
!sandbox_manager/pyproject.toml
!sandbox_manager/uv.lock
!sandbox_manager/sandbox_manager/
!infra/egress-proxy/tinyproxy.conf
!infra/egress-proxy/allowlist
!frontend/package.json
!frontend/package-lock.json
!frontend/.npmrc
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/public/
!frontend/src/
!frontend/nginx/default.conf
**/node_modules
**/__tests__
**/__pycache__
**/*.pyc
